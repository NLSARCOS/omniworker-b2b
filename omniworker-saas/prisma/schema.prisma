// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT (Empresa/Organización) ───
model Tenant {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  planId      String?
  plan        SubscriptionPlan? @relation(fields: [planId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Datos de contacto
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  website       String?
  // Datos fiscales
  taxId         String?
  address       String?
  city          String?
  country       String?
  postalCode    String?
  // Notas internas
  notes         String?

  // Subscription state
  subscriptionEndsAt DateTime?

  users       User[]
  edgeAgents  EdgeAgent[]
  apiKeys     TenantApiKey[]
  licenses    License[]
  tasks       TaskLog[]
  invoices    Invoice[]
  orchestratorTasks OrchestratorTask[]
}

// ─── API KEYS (para edge agents) ───
model TenantApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  // Tenant deletion cascades to all associated Tenant API keys
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licenseId   String?
  // License deletion cascades to all associated Tenant API keys
  license     License?  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String
  name        String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([licenseId])
}

// ─── USER ───
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          String    @default("USER")
  tenantId      String?
  // If a Tenant is deleted, users remain but their tenantId is set to NULL
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tokenBalance  Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  tasks         TaskLog[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

// ─── ORCHESTRATOR TASK — multi-tenant distributed task queue ────────────────
// Each tenant enqueues tasks here. The cron endpoint uses PostgreSQL's
// SELECT … FOR UPDATE SKIP LOCKED to process rows across multiple pods
// without duplicates or a Redis broker.
model OrchestratorTask {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String    // who created the task
  title       String
  body        String?   @db.Text
  agentType   String    @default("general_agent")  // developer|reviewer|researcher|planner|general_agent
  status      String    @default("pending")         // pending|in_progress|done|failed|cancelled
  priority    Int       @default(5)                 // 1=critical … 10=low
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  result      String?   @db.Text
  error       String?   @db.Text
  lockedAt    DateTime?                             // set when a worker picks it up
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([tenantId, status])
  @@index([userId])
}

// ─── AGENT MEMORY — persistent cross-session context store ─────────────────
// Persists the context-bridge ContextHeader to PostgreSQL so that agents
// remember decisions, active files, and current task across server restarts,
// model switches, and browser refreshes.
//
// Write path: async, after each LLM response (non-blocking).
// Read path:  on session start — seed the in-memory cache before the first
//             request so the model never starts cold.
model AgentMemory {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String   // conversationId or derived hash (see chat route)
  userId      String

  // Structured context (mirrors ContextHeader from context-bridge.ts)
  sessionSummary  String?  @db.Text
  currentTask     String?  @db.Text
  recentDecisions String[] @default([])   // last 5 decisions
  keyEntities     String[] @default([])   // files, modules, concepts
  goals           String[] @default([])
  activeFiles     String[] @default([])
  pendingErrors   String[] @default([])
  lastModel       String?                 // which model produced this memory

  // Raw tail (last 5 messages, JSON-encoded) for quick session resume
  lastMessages    Json?

  messageCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, sessionId])
  @@index([tenantId, userId])
  @@index([updatedAt])
}

// ─── REFRESH TOKEN ───
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
}

// ─── SUBSCRIPTION PLANS ───
model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  tokenLimit    Int
  maxAgents     Int      @default(1)
  maxUsers      Int      @default(1)
  maxLicenses   Int      @default(1)
  price         Int      // Price stored in cents
  billingPeriod String   @default("monthly")
  isActive      Boolean  @default(true)
  isPublic      Boolean  @default(true)
  features      String   @default("[]")
  sortOrder     Int      @default(0)

  tenants       Tenant[]
}

// ─── TASK LOG ───
model TaskLog {
  id             String   @id @default(uuid())
  tenantId       String?
  // Tenant deletion cascades to all associated TaskLogs
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  // User deletion cascades to all associated TaskLogs
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTokens   Int      @default(0)
  completionTks  Int      @default(0)
  modelUsed      String
  taskType       String
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
}

// ─── CONVERSATION MODEL PIN — afinidad de modelo por conversación ───
// Fija el provider/model elegido en el primer turno de una conversación para
// que el router no cambie de modelo a media tarea. Solo se re-fija cuando el
// modelo fijado falla (error o health-check negativo).
model ConversationModel {
  conversationId String   @id
  userId         String
  provider       String
  model          String
  endpoint       String?
  pinnedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([pinnedAt])
}

// ─── MASTER PROVIDERS — multi-key por proveedor ───
model MasterProvider {
  id           String   @id @default(uuid())
  name         String
  provider     String
  apiKey       String
  defaultModel String   @default("gpt-4o-mini")
  baseUrl      String?
  isActive     Boolean  @default(true)
  priority     Int      @default(1)
  dailyLimit   Int?
  usedToday    Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([provider, isActive])
}

model ProviderModelHealth {
  id                String   @id @default(uuid())
  providerId        String
  modelId           String
  status            String   @default("available") // available | degraded | unavailable
  latencyMs         Int?
  lastCheckedAt     DateTime  @default(now())
  lastSuccessAt     DateTime?
  lastError         String?
  consecutiveFails  Int      @default(0)
  consecutiveSuccess Int      @default(0)
  totalChecks       Int      @default(0)
  totalFails        Int      @default(0)

  @@unique([providerId, modelId])
  @@index([providerId, status])
}

// ─── ADMIN AUDIT LOG ───
model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}

// ─── LICENSE ───────────────────────────────────────────────────────────────
model License {
  id               String    @id @default(uuid())
  tenantId         String
  // Tenant deletion cascades to all associated Licenses
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  status           String    @default("ACTIVE")
  deviceFingerprint String?
  tokenBalance     Int       @default(0)
  activatedAt      DateTime  @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKeys          TenantApiKey[]
  edgeAgents       EdgeAgent[]

  @@index([tenantId])
  @@index([status])
}

// ─── EDGE AGENT ───
model EdgeAgent {
  id            String    @id @default(uuid())
  tenantId      String
  // Tenant deletion cascades to all associated EdgeAgents
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licenseId     String?
  // License deletion cascades to all associated EdgeAgents
  license       License?  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agentName     String
  hostname      String?
  platform      String?
  status        String    @default("offline")
  lastSeenAt    DateTime?
  capabilities  String    @default("[]")
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([licenseId])
}

// ─── APP UPDATE ───
model AppUpdate {
  id           String   @id @default(uuid())
  version      String   @unique
  urlWindows   String
  urlMac       String
  urlLinux     String
  releaseNotes String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── INVOICE B2B ───
model Invoice {
  id             String   @id @default(uuid())
  tenantId       String
  // Tenant deletion cascades to all associated Invoices
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount         Int      // Amount stored in cents
  currency       String   @default("USD")
  status         String   @default("PAID")
  description    String?
  invoiceNumber  String   @unique
  paymentMethod  String   @default("MANUAL")
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}